# MongoDB Connection (MongoDB Atlas or Local)
MONGO_URL=mongodb+srv://<username>:<password>@cluster0.mongodb.net/?appName=Cluster0
DB_NAME=divine_yoga

# Admin Credentials
ADMIN_EMAIL=admin@divineyogastudio.in
ADMIN_PASSWORD=your_strong_admin_password
SEED_DEMO_DATA=true

# Security Secrets (Generate random secure strings for production)
JWT_SECRET=your_jwt_secret_key_here
FIELD_ENCRYPTION_SECRET=your_32_byte_base64_encryption_secret_here

# CORS Origins (Comma-separated URLs for your frontend)
CORS_ORIGINS=http://localhost:3000,https://divineyogastudio.vercel.app

# WATI WhatsApp API (Optional - leave blank if not using WATI)
WATI_BASE_URL=
WATI_ALLOWED_HOST=
WATI_API_TOKEN=
WATI_PAYMENT_TEMPLATE_NAME=
WATI_WEBHOOK_API_KEY=
